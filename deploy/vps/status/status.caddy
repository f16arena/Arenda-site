# Панель состояния сервера. Ставится install.sh в /etc/caddy/sites/status.caddy.
# Вход — своя страница в server.py (пароль меняется из панели), не basic_auth Caddy.
status.commrent.kz {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:3400
}
