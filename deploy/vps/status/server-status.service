# Панель состояния cloud-001 (status.commrent.kz). Ставится install.sh в /etc/systemd/system/.
[Unit]
Description=cloud-001 status page
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/server-status/server.py
Restart=always
RestartSec=3
# Читает /proc, docker.sock и журналы; пишет только в StateDirectory (ниже).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Пароль (scrypt-хеш) и ключ сессий — /var/lib/server-status/auth.json, единственное, куда служба пишет.
StateDirectory=server-status
StateDirectoryMode=0700
# Чтение journald (3,5 ГБ) засчитывается в память службы как кэш файлов: на MemoryHigh ядро его
# вытесняет, а не убивает процесс (при MemoryMax=300M без High отчёт за 7 дней ловил OOM).
MemoryHigh=400M
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
